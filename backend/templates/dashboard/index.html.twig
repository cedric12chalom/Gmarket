  const filtered = commandes.filter((c) => {
    if (!search) return true;
    const haystack = `${c.id} ${c.acheteur?.nom || ''} ${c.acheteur?.prenom || ''} ${producteurNomForCommande(c)}`.toLowerCase();
    return haystack.includes(search.toLowerCase());
  });

  const handleExport = () => {
    if (filtered.length === 0) {
      toast('Aucune commande à exporter.', 'error');
      return;
    }
    exportToCsv('commandes.csv', filtered.map((c) => ({
      id: c.id,
      client: `${c.acheteur?.nom || ''} ${c.acheteur?.prenom || ''}`.trim(),
      producteur: producteurNomForCommande(c),
      montant_total: c.montant_total,
      date_commande: c.date_commande,
      statut: c.statut,
    })));
    toast(`${filtered.length} commande(s) exportée(s).`);
  };

  return (
    <div className="space-y-6 animate-fade-in">
      <div className="flex items-center justify-between flex-wrap gap-3">
        <div className="flex items-center gap-4">
          <div className="relative">
            <span className="absolute left-3 top-1/2 -translate-y-1/2 text-earth-400"><Icons.search /></span>
            <input type="text" placeholder="Rechercher une commande..." value={search} onChange={(e) => setSearch(e.target.value)}
              className="pl-10 pr-4 py-2.5 bg-white border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent w-80" />
          </div>
        </div>
        <button onClick={handleExport} className="flex items-center gap-2 px-4 py-2.5 bg-primary-600 text-white rounded-xl text-sm font-medium hover:bg-primary-700 transition">
          <Icons.download /> Exporter
        </button>
      </div>

      <SectionCard title="Toutes les commandes" icon={Icons.package}>
        {loading ? (
          <p className="text-sm text-earth-400 py-6 text-center">Chargement...</p>
        ) : filtered.length === 0 ? (
          <p className="text-sm text-earth-400 py-6 text-center">Aucune commande.</p>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full">
              <thead>
                <tr className="text-left text-xs text-earth-500 uppercase tracking-wider border-b border-earth-200">
                  <th className="pb-3 font-medium">Commande</th>
                  <th className="pb-3 font-medium">Client</th>
                  <th className="pb-3 font-medium">Producteur</th>
                  <th className="pb-3 font-medium">Montant</th>
                  <th className="pb-3 font-medium">Date</th>
                  <th className="pb-3 font-medium">Statut</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-earth-100">
                {filtered.map((order) => (
                  <tr key={order.id} className="hover:bg-earth-50 transition-colors">
                    <td className="py-4"><span className="font-mono text-sm font-medium text-earth-900">CMD-{order.id}</span></td>
                    <td className="py-4 text-sm text-earth-700">{order.acheteur?.nom} {order.acheteur?.prenom}</td>
                    <td className="py-4 text-sm text-earth-700">{producteurNomForCommande(order)}</td>
                    <td className="py-4 text-sm font-semibold text-earth-900">{formatPrice(order.montant_total)}</td>
                    <td className="py-4 text-sm text-earth-500">{formatDate(order.date_commande)}</td>
