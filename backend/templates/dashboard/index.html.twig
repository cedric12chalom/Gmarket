      <span className={`w-1.5 h-1.5 rounded-full ${config.dot}`}></span>
      {config.label}
    </span>
  );
};

const StatCard = ({ title, value, subValue, trend, trendUp, icon: Icon, color, delay }) => {
  const [count, setCount] = useState(0);
  const target = typeof value === 'number' ? value : 0;

  useEffect(() => {
    if (typeof value !== 'number') return;
    const duration = 1500, steps = 60, increment = target / steps;
    let current = 0;
    const timer = setInterval(() => {
      current += increment;
      if (current >= target) { setCount(target); clearInterval(timer); }
      else { setCount(Math.floor(current)); }
    }, duration / steps);
    return () => clearInterval(timer);
  }, [value]);

  const colorClasses = {
    green: 'bg-primary-50 text-primary-600 border-primary-200',
    amber: 'bg-secondary-50 text-secondary-600 border-secondary-200',
    blue: 'bg-blue-50 text-blue-600 border-blue-200',
    red: 'bg-red-50 text-red-600 border-red-200',
