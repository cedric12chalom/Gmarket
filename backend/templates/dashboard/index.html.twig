                    <td className="py-4 text-sm text-earth-600">{c.type_transport}</td>
                    <td className="py-4 text-sm text-earth-600">{formatPrice(c.commission_fixe)}</td>
                    <td className="py-4 text-sm text-earth-600">{c.commission_pourcent}%</td>
                    <td className="py-4">
                      <span className={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium ${c.approuve ? 'bg-primary-100 text-primary-700' : 'bg-secondary-100 text-secondary-700'}`}>
                        {c.approuve ? 'Approuvée' : 'En attente'}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </SectionCard>

      {showCreate && (
        <Modal title="Nouvelle catégorie" onClose={() => setShowCreate(false)}>
          <CreateCategorieForm toast={toast} onClose={() => setShowCreate(false)} onCreated={(c) => setCategories((prev) => [...prev, c])} />
        </Modal>
      )}
    </div>
  );
};

const ProduitsTab = ({ toast }) => {
  const [produits, setProduits] = useState([]);
  const [categories, setCategories] = useState([]);
  const [loading, setLoading] = useState(true);
  const [showCreate, setShowCreate] = useState(false);

  const load = () => {
    setLoading(true);
    Promise.all([apiFetch('/produits'), apiFetch('/categories')])
      .then(([p, c]) => { setProduits(p); setCategories(c); })
      .catch((err) => toast(err.message, 'error'))
      .finally(() => setLoading(false));
  };

  useEffect(() => { load(); }, []);

  return (
    <div className="space-y-6 animate-fade-in">
      <div className="flex items-center justify-end">
        <button onClick={() => setShowCreate(true)} className="px-4 py-2.5 bg-primary-600 text-white rounded-xl text-sm font-medium hover:bg-primary-700 transition">+ Nouveau produit</button>
      </div>

      <SectionCard title="Catalogue produits" icon={Icons.leaf}>
        {loading ? (
          <p className="text-sm text-earth-400 py-6 text-center">Chargement...</p>
        ) : produits.length === 0 ? (
          <p className="text-sm text-earth-400 py-6 text-center">Aucun produit pour le moment.</p>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full">
              <thead>
                <tr className="text-left text-xs text-earth-500 uppercase tracking-wider border-b border-earth-200">
                  <th className="pb-3 font-medium">Nom</th>
                  <th className="pb-3 font-medium">Catégorie</th>
                  <th className="pb-3 font-medium">Unité</th>
                  <th className="pb-3 font-medium">Fourchette de prix</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-earth-100">
                {produits.map((p) => (
                  <tr key={p.id} className="hover:bg-earth-50 transition-colors">
                    <td className="py-4">
                      <p className="text-sm font-medium text-earth-900">{p.nom}</p>
                      {p.description && <p className="text-xs text-earth-400 truncate max-w-xs">{p.description}</p>}
                    </td>
                    <td className="py-4 text-sm text-earth-600">{p.categorie?.nom || '—'}</td>
                    <td className="py-4 text-sm text-earth-600">{p.unite}</td>
                    <td className="py-4 text-sm text-earth-600">{formatPrice(p.prix_min)} – {formatPrice(p.prix_max)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </SectionCard>

      {showCreate && (
        <Modal title="Nouveau produit" onClose={() => setShowCreate(false)}>
          <CreateProduitForm categories={categories} toast={toast} onClose={() => setShowCreate(false)} onCreated={(p) => setProduits((prev) => [...prev, p])} />
        </Modal>
      )}
    </div>
  );
};

const VERIF_STYLES = {
  en_attente: { label: 'En attente', chip: 'bg-amber-100 text-amber-700', dot: 'bg-amber-500' },
  verifie: { label: 'Vérifié', chip: 'bg-blue-100 text-blue-700', dot: 'bg-blue-500' },
  valide: { label: 'Validé', chip: 'bg-primary-100 text-primary-700', dot: 'bg-primary-500' },
  refuse: { label: 'Refusé', chip: 'bg-red-100 text-red-700', dot: 'bg-red-500' },
};

const VerificationBadge = ({ statut }) => {
  const cfg = VERIF_STYLES[statut] || VERIF_STYLES.en_attente;
  return (
    <span className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium ${cfg.chip}`}>
      <span className={`w-1.5 h-1.5 rounded-full ${cfg.dot}`}></span>
      {cfg.label}
    </span>
  );
};

const VerificationsTab = ({ toast }) => {
  const [livreurs, setLivreurs] = useState([]);
  const [loading, setLoading] = useState(true);
  const [statut, setStatut] = useState('en_attente');
  const [actionBusy, setActionBusy] = useState(false);

  const load = (s = statut) => {
    setLoading(true);
    apiFetch(`/admin/livreurs/verification${s ? `?statut=${s}` : ''}`)
      .then(setLivreurs)
      .catch((err) => toast(err.message, 'error'))
      .finally(() => setLoading(false));
  };

  useEffect(() => { load(); }, []);

  const runAction = async (id, action) => {
    setActionBusy(true);
    try {
      let body = {};
      if (action === 'refuser') {
        const motif = window.prompt('Motif du refus :');
        if (!motif || !motif.trim()) { setActionBusy(false); return; }
        body = { motif: motif.trim() };
      }
      await apiFetch(`/admin/livreurs/${id}/${action}`, { method: 'PUT', body: JSON.stringify(body) });
      toast(action === 'valider' ? 'Dossier validé.' : action === 'verifier' ? 'Dossier marqué comme vérifié.' : 'Dossier refusé.');
      load();
    } catch (err) {
      toast(err.message, 'error');
    } finally {
      setActionBusy(false);
    }
  };

  const filterTabs = [
    { id: 'en_attente', label: 'En attente' },
    { id: 'verifie', label: 'Vérifiés' },
    { id: 'valide', label: 'Validés' },
    { id: 'refuse', label: 'Refusés' },
  ];

  return (
    <div className="space-y-6 animate-fade-in">
      <div className="flex flex-wrap gap-2">
        {filterTabs.map((t) => (
          <button key={t.id} onClick={() => { setStatut(t.id); load(t.id); }}
            className={`px-4 py-2 rounded-xl text-sm font-medium border transition ${statut === t.id ? 'bg-earth-900 text-white border-earth-900' : 'bg-white border-earth-200 text-earth-600 hover:border-earth-300'}`}>
            {t.label}
          </button>
        ))}
      </div>

      {loading ? (
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          {[...Array(6)].map((_, i) => (
            <div key={i} className="p-5 bg-white border border-earth-200 rounded-2xl animate-pulse">
              <div className="h-4 w-2/3 bg-earth-100 rounded mb-2"></div>
              <div className="h-3 w-1/2 bg-earth-100 rounded mb-2"></div>
              <div className="h-3 w-1/3 bg-earth-100 rounded"></div>
            </div>
          ))}
        </div>
      ) : livreurs.length === 0 ? (
        <div className="py-16 text-center bg-white border border-earth-200 rounded-2xl">
          <span className="inline-flex text-earth-300 mb-2"><Icons.truck /></span>
          <p className="text-sm text-earth-400">Aucun livreur dans cette catégorie.</p>
        </div>
      ) : (
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          {livreurs.map((l) => (
            <div key={l.id} className="p-5 bg-white border border-earth-200 rounded-2xl">
              <div className="flex items-start justify-between gap-3">
                <div className="flex items-center gap-3">
                  <div className="w-12 h-12 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white font-bold">
                    {(l.prenom || '?')[0]}{(l.nom || '?')[0]}
                  </div>
                  <div>
                    <p className="font-semibold text-earth-900">{l.nom} {l.prenom}</p>
                    <p className="text-xs text-earth-400">{l.email}</p>
                    <p className="text-xs text-earth-500 mt-0.5">{l.telephone}</p>
                  </div>
                </div>
                <VerificationBadge statut={l.statut_verification} />
              </div>

              <div className="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                <div className="text-earth-500"><span className="font-medium text-earth-700">Ville :</span> {l.ville || '—'}</div>
                <div className="text-earth-500"><span className="font-medium text-earth-700">Quartier :</span> {l.quartier || '—'}</div>
                <div className="text-earth-500"><span className="font-medium text-earth-700">Transport :</span> {l.type_transport || '—'}</div>
                <div className="text-earth-500"><span className="font-medium text-earth-700">Moyen :</span> {l.moyen_deplacement || '—'}</div>
                <div className="text-earth-500"><span className="font-medium text-earth-700">CNI :</span> {l.cni_numero || '—'}</div>
                <div className="text-earth-500"><span className="font-medium text-earth-700">Mobile Money :</span> {l.mobile_money_numero || '—'}</div>
                <div className="text-earth-500"><span className="font-medium text-earth-700">Véhicule :</span> {l.vehicule_marque_modele || '—'}{l.vehicule_plaque ? ` (${l.vehicule_plaque})` : ''}</div>
                <div className="text-earth-500"><span className="font-medium text-earth-700">Contact urgence :</span> {l.contact_urgence_telephone || '—'}</div>
              </div>

              {(l.cni_photo || l.photo_profil) && (
                <div className="mt-3 flex gap-3">
                  {l.photo_profil && <a href={l.photo_profil} target="_blank" rel="noreferrer" className="text-xs text-primary-600 hover:underline">Photo profil ↗</a>}
                  {l.cni_photo && <a href={l.cni_photo} target="_blank" rel="noreferrer" className="text-xs text-primary-600 hover:underline">Pièce d'identité ↗</a>}
                </div>
              )}

              {l.statut_verification === 'refuse' && l.motif_refus && (
                <p className="mt-3 text-xs text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2">Motif du refus : {l.motif_refus}</p>
              )}

              <div className="mt-4 pt-3 border-t border-earth-100 flex items-center justify-end gap-2">
                {l.statut_verification !== 'valide' ? (
                  <>
                    <button onClick={() => runAction(l.id, 'verifier')} disabled={actionBusy}
                      className="px-3 py-2 rounded-lg text-xs font-medium border border-earth-200 text-earth-600 hover:bg-earth-50 transition disabled:opacity-50">Vérifier</button>
                    <button onClick={() => runAction(l.id, 'valider')} disabled={actionBusy}
                      className="px-3 py-2 rounded-lg text-xs font-medium bg-primary-600 text-white hover:bg-primary-700 transition disabled:opacity-50">Valider</button>
                    <button onClick={() => runAction(l.id, 'refuser')} disabled={actionBusy}
                      className="px-3 py-2 rounded-lg text-xs font-medium bg-red-600 text-white hover:bg-red-700 transition disabled:opacity-50">Refuser</button>
                  </>
                ) : (
                  <span className="text-xs text-primary-600 font-medium">Éligible aux missions</span>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
};

const Sidebar = ({ activeTab, setActiveTab, collapsed, setCollapsed, onLogout }) => {
  const menuItems = [
    { id: 'overview', label: 'Vue d\'ensemble', icon: Icons.dashboard },
    { id: 'commandes', label: 'Commandes', icon: Icons.package },
    { id: 'livraisons', label: 'Livraisons', icon: Icons.truck },
    { id: 'litiges', label: 'Litiges', icon: Icons.alert },
    { id: 'paiements', label: 'Paiements', icon: Icons.money },
    { id: 'users', label: 'Utilisateurs', icon: Icons.users },
    { id: 'verifications', label: 'Vérifications', icon: Icons.check },
    { id: 'categories', label: 'Catégories', icon: Icons.tag },
    { id: 'produits', label: 'Produits', icon: Icons.leaf },
  ];

  return (
    <aside className={`fixed left-0 top-0 h-full bg-white border-r border-earth-200 z-40 transition-all duration-300 ${collapsed ? 'w-20' : 'w-72'}`}>
      <div className="h-16 flex items-center px-6 border-b border-earth-100">
        <div className="flex items-center gap-3">
          <div className="w-9 h-9 bg-primary-600 rounded-xl flex items-center justify-center flex-shrink-0"><Icons.leaf /></div>
          {!collapsed && (
            <div>
              <span className="text-lg font-bold text-earth-900">TerraLink</span>
              <span className="block text-[10px] text-earth-400 uppercase tracking-wider">Administration</span>
            </div>
          )}
        </div>
      </div>

      <nav className="p-3 space-y-1">
        {menuItems.map((item) => (
          <button key={item.id} onClick={() => setActiveTab(item.id)}
            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all sidebar-link ${
              activeTab === item.id ? 'active shadow-md' : 'text-earth-600 hover:text-earth-900'
            }`}>
            <item.icon />
            {!collapsed && <span>{item.label}</span>}
          </button>
        ))}
      </nav>

      <div className="absolute bottom-0 left-0 right-0 p-3 border-t border-earth-100">
        <button onClick={onLogout} className="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-earth-600 hover:bg-earth-50 hover:text-red-600 transition">
          <Icons.logout />
          {!collapsed && <span>Deconnexion</span>}
        </button>
      </div>
    </aside>
  );
};

const TopBar = ({ collapsed, setCollapsed, notifications, onMarkOneRead, onMarkAllRead }) => {
  const [notifOpen, setNotifOpen] = useState(false);
  const unreadCount = notifications.filter(n => !n.lu).length;

  return (
    <header className={`fixed top-0 right-0 h-16 bg-white/80 backdrop-blur-md border-b border-earth-200 z-30 transition-all duration-300 ${collapsed ? 'left-20' : 'left-72'}`}>
      <div className="h-full flex items-center justify-between px-6">
        <div className="flex items-center gap-4">
          <button onClick={() => setCollapsed(!collapsed)} className="p-2 hover:bg-earth-100 rounded-lg transition text-earth-600"><Icons.menu /></button>
          <div className="relative">
            <span className="absolute left-3 top-1/2 -translate-y-1/2 text-earth-400"><Icons.search /></span>
            <input type="text" placeholder="Rechercher..." 
              className="pl-10 pr-4 py-2 bg-earth-50 border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent w-64" />
          </div>
        </div>

        <div className="flex items-center gap-3">
          <div className="relative">
            <button onClick={() => setNotifOpen(!notifOpen)} className="relative p-2 hover:bg-earth-100 rounded-xl transition text-earth-600">
              <Icons.bell />
              {unreadCount > 0 && (
                <span className="absolute -top-1 -right-1 w-5 h-5 bg-danger text-white text-xs font-bold rounded-full flex items-center justify-center">{unreadCount}</span>
              )}
            </button>

            {notifOpen && (
              <div className="absolute right-0 top-full mt-2 w-80 bg-white rounded-2xl shadow-xl border border-earth-200 overflow-hidden animate-fade-in">
                <div className="px-4 py-3 border-b border-earth-100 flex items-center justify-between">
                  <h4 className="font-semibold text-earth-900 text-sm">Notifications</h4>
                  <button onClick={onMarkAllRead} className="text-xs text-primary-600 hover:text-primary-700">Tout marquer comme lu</button>
                </div>
                <div className="max-h-80 overflow-y-auto">
                  {notifications.length === 0 ? (
                    <p className="text-sm text-earth-400 text-center py-6">Aucune notification.</p>
                  ) : notifications.map((notif) => (
                    <div key={notif.id} onClick={() => !notif.lu && onMarkOneRead(notif.id)}
                      className={`px-4 py-3 hover:bg-earth-50 transition cursor-pointer border-b border-earth-50 ${!notif.lu ? 'bg-primary-50/30' : ''}`}>
                      <div className="flex items-start gap-3">
                        <div className={`w-2 h-2 rounded-full mt-1.5 flex-shrink-0 ${!notif.lu ? 'bg-primary-500 pulse-dot' : 'bg-earth-300'}`}></div>
                        <div>
                          <p className="text-sm font-medium text-earth-900">{notif.titre}</p>
                          <p className="text-xs text-earth-500 mt-0.5">{notif.message}</p>
                          <p className="text-xs text-earth-400 mt-1">{formatDate(notif.date_envoi)}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div className="flex items-center gap-3 pl-3 border-l border-earth-200">
            <div className="text-right hidden sm:block">
              <p className="text-sm font-medium text-earth-900">Admin TerraLink</p>
              <p className="text-xs text-earth-400">Administrateur</p>
            </div>
            <div className="w-9 h-9 bg-primary-600 rounded-full flex items-center justify-center text-white font-bold text-sm">AT</div>
          </div>
        </div>
      </div>
    </header>
  );
};

const AdminDashboard = ({ onLogout, toast }) => {
  const [activeTab, setActiveTab] = useState('overview');
  const [collapsed, setCollapsed] = useState(false);
  const [notifications, setNotifications] = useState([]);

  useEffect(() => {
    apiFetch('/notifications')
      .then(setNotifications)
      .catch(() => { /* notifications are non-critical; fail quietly */ });
  }, []);

  const markOneRead = async (id) => {
    try {
      await apiFetch(`/notifications/${id}/lu`, { method: 'PUT' });
      setNotifications((prev) => prev.map((n) => (n.id === id ? { ...n, lu: true } : n)));
    } catch (err) {
      toast(err.message, 'error');
    }
  };

  const markAllRead = async () => {
    try {
      await apiFetch('/notifications/lu', { method: 'PUT' });
      setNotifications((prev) => prev.map((n) => ({ ...n, lu: true })));
    } catch (err) {
      toast(err.message, 'error');
    }
  };

  const tabs = {
    overview: <OverviewTab toast={toast} />,
    commandes: <CommandesTab toast={toast} />,
    livraisons: <LivraisonsTab toast={toast} />,
    litiges: <LitigesTab toast={toast} />,
    paiements: <PaiementsTab toast={toast} />,
    users: <UsersTab toast={toast} />,
    verifications: <VerificationsTab toast={toast} />,
    categories: <CategoriesTab toast={toast} />,
    produits: <ProduitsTab toast={toast} />,
  };

  const titles = {
    overview: 'Tableau de bord',
    commandes: 'Gestion des commandes',
    livraisons: 'Suivi des livraisons',
    litiges: 'Gestion des litiges',
    paiements: 'Paiements et finances',
    users: 'Gestion des utilisateurs',
    verifications: 'Vérification des livreurs',
    categories: 'Gestion des catégories',
    produits: 'Gestion des produits',
  };

  return (
    <div className="min-h-screen bg-earth-50">
      <Sidebar activeTab={activeTab} setActiveTab={setActiveTab} collapsed={collapsed} setCollapsed={setCollapsed} onLogout={onLogout} />
      <TopBar collapsed={collapsed} setCollapsed={setCollapsed} notifications={notifications} onMarkOneRead={markOneRead} onMarkAllRead={markAllRead} />

      <main className={`pt-16 transition-all duration-300 ${collapsed ? 'ml-20' : 'ml-72'}`}>
        <div className="p-6">
          <div className="mb-6">
            <h1 className="text-2xl font-bold text-earth-900">{titles[activeTab]}</h1>
            <p className="text-sm text-earth-500 mt-1">{new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</p>
          </div>
          {tabs[activeTab]}
        </div>
      </main>
    </div>
  );
};

const Root = () => {
  const [authed, setAuthed] = useState(!!localStorage.getItem(ADMIN_TOKEN_KEY));
  const { push, ToastHost } = useToasts();

  const logout = () => {
    localStorage.removeItem(ADMIN_TOKEN_KEY);
    setAuthed(false);
  };

  return (
    <>
      {authed ? (
        <AdminDashboard onLogout={logout} toast={push} />
      ) : (
        <LoginScreen onLoggedIn={() => setAuthed(true)} toast={push} />
      )}
      <ToastHost />
    </>
  );
};

const root = ReactDOM.createRoot(document.getElementById('admin-root'));
root.render(<Root />);
</script>
