const LitigesTab = ({ toast }) => {
  const [litiges, setLitiges] = useState([]);
  const [loading, setLoading] = useState(true);
  const [resolvingId, setResolvingId] = useState(null);
  const [resolutionText, setResolutionText] = useState('');
  const [busyId, setBusyId] = useState(null);

  const load = () => {
    setLoading(true);
    apiFetch('/admin/litiges')
      .then(setLitiges)
      .catch((err) => toast(err.message, 'error'))
      .finally(() => setLoading(false));
  };

  useEffect(() => { load(); }, []);

  const updateLitige = async (id, payload) => {
    setBusyId(id);
    try {
      const updated = await apiFetch(`/admin/litiges/${id}`, { method: 'PUT', body: JSON.stringify(payload) });
      setLitiges((prev) => prev.map((l) => (l.id === id ? updated : l)));
      toast('Litige mis à jour.');
    } catch (err) {
      toast(err.message, 'error');
    } finally {
      setBusyId(null);
    }
  };

  const submitResolution = async (id) => {
    await updateLitige(id, { statut: 'resolu', resolution: resolutionText });
    setResolvingId(null);
    setResolutionText('');
  };

  const countByStatut = (statut) => litiges.filter((l) => l.statut === statut).length;

  return (
    <div className="space-y-6 animate-fade-in">
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <StatCard title="Ouverts" value={loading ? '…' : countByStatut('ouvert')} icon={Icons.alert} color="red" delay={0} />
        <StatCard title="En traitement" value={loading ? '…' : countByStatut('en_traitement')} icon={Icons.message} color="amber" delay={100} />
        <StatCard title="Resolus" value={loading ? '…' : countByStatut('resolu')} icon={Icons.check} color="green" delay={200} />
      </div>

      <SectionCard title="Litiges" icon={Icons.alert}>
        {loading ? (
          <p className="text-sm text-earth-400 py-6 text-center">Chargement...</p>
        ) : litiges.length === 0 ? (
          <p className="text-sm text-earth-400 py-6 text-center">Aucun litige.</p>
        ) : (
          <div className="space-y-4">
            {litiges.map((litige) => (
              <div key={litige.id} className="border border-earth-200 rounded-xl p-4 hover:border-primary-300 transition">
                <div className="flex items-start justify-between flex-wrap gap-3">
                  <div className="flex items-start gap-4">
                    <div className="p-3 rounded-xl bg-red-50 text-red-600">
                      <Icons.alert />
                    </div>
                    <div>
                      <div className="flex items-center gap-2">
                        <span className="font-mono text-sm font-medium text-earth-900">LIT-{litige.id}</span>
                        <span className="text-earth-400">•</span>
                        <span className="text-sm text-earth-500">CMD-{litige.commande?.id}</span>
                      </div>
                      <p className="text-sm text-earth-600 mt-1">{litige.motif}</p>
                      {litige.description && <p className="text-xs text-earth-500 mt-1">{litige.description}</p>}
                      <p className="text-xs text-earth-400 mt-1">Ouvert le {formatDate(litige.date_creation)}</p>
                      {litige.resolution && <p className="text-xs text-primary-600 mt-1">Résolution : {litige.resolution}</p>}
                    </div>
                  </div>
                  <div className="flex items-center gap-2">
                    <Badge status={litige.statut} />
                    {litige.statut === 'ouvert' && (
                      <button disabled={busyId === litige.id} onClick={() => updateLitige(litige.id, { statut: 'en_traitement' })}
                        className="px-3 py-1.5 bg-primary-600 text-white text-xs font-medium rounded-lg hover:bg-primary-700 transition disabled:opacity-50">Traiter</button>
                    )}
                    {(litige.statut === 'ouvert' || litige.statut === 'en_traitement') && (
                      <button disabled={busyId === litige.id} onClick={() => { setResolvingId(litige.id); setResolutionText(''); }}
                        className="px-3 py-1.5 bg-earth-800 text-white text-xs font-medium rounded-lg hover:bg-earth-900 transition disabled:opacity-50">Résoudre</button>
                    )}
                    {(litige.statut === 'ouvert' || litige.statut === 'en_traitement') && (
                      <button disabled={busyId === litige.id} onClick={() => updateLitige(litige.id, { statut: 'rejete' })}
                        className="px-3 py-1.5 bg-white border border-earth-200 text-earth-600 text-xs font-medium rounded-lg hover:bg-earth-50 transition disabled:opacity-50">Rejeter</button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </SectionCard>

      {resolvingId !== null && (
        <Modal title="Résoudre le litige" onClose={() => setResolvingId(null)}>
          <form onSubmit={(e) => { e.preventDefault(); submitResolution(resolvingId); }}>
            <Field label="Résolution">
              <textarea required className={inputCls} rows={4} value={resolutionText} onChange={(e) => setResolutionText(e.target.value)} placeholder="Décrivez comment le litige a été résolu..." />
            </Field>
            <SubmitButton loading={busyId === resolvingId}>Confirmer la résolution</SubmitButton>
          </form>
        </Modal>
      )}
    </div>
  );
};

